#!/usr/bin/env bash

set -euo pipefail

usage() {
  cat <<EOF
Usage: ${0##*/} [-h | --help] [ARCHIVE]

Installs a Zed build produced by the "Fork release" GitHub workflow
system-wide, without compiling:

  \$PREFIX/bin/zed                     CLI (default: /usr/bin/zed)
  \$PREFIX/lib/zed/                    Editor, CLI and bundled libraries
  \$PREFIX/share/applications/         Desktop entry
  \$PREFIX/share/icons/                App icons
  ~/.zed_server/zed-remote-server-*   Remote development server (matches this build)

ARCHIVE is a local zed-linux-<arch>.tar.gz from the workflow. Without it, the
archive for this machine's architecture is downloaded from the latest release.

If a remote server daemon is already running, it is stopped before the new
binary is installed and started again afterward.

Environment:
  PREFIX            Install prefix (default: /usr)
  SUDO              Privilege helper (default: sudo; unused as root)
  SUDO_ASKPASS      Password helper; when set, sudo runs with -A
  ZED_RELEASE_REPO  GitHub repository to download from (default: belizariogr/zed)
  ZED_RELEASE_TAG   Release tag to download (default: latest release)
EOF
}

archive=""
if [[ $# -gt 1 ]]; then
  usage >&2
  exit 1
elif [[ $# -eq 1 ]]; then
  if [[ "$1" == "-h" || "$1" == "--help" ]]; then
    usage
    exit 0
  fi
  archive="$1"
  if [[ ! -f "$archive" ]]; then
    echo "error: archive not found: ${archive}" >&2
    exit 1
  fi
fi

if [[ "$(uname -s)" != "Linux" ]]; then
  echo "error: this script requires Linux." >&2
  exit 1
fi

PREFIX="${PREFIX:-/usr}"
SUDO="${SUDO-sudo}"
repository="${ZED_RELEASE_REPO:-belizariogr/zed}"
tag="${ZED_RELEASE_TAG:-}"

privileged=()
if [[ -n "$SUDO" && "$(id -u)" != 0 ]]; then
  if ! command -v "$SUDO" >/dev/null 2>&1; then
    echo "error: '${SUDO}' not found. Install as root or set SUDO=." >&2
    exit 1
  fi
  privileged=("$SUDO")
  # The editor's auto-updater asks for the password itself and passes it to
  # sudo through SUDO_ASKPASS.
  if [[ -n "${SUDO_ASKPASS:-}" && "$(basename "$SUDO")" == sudo ]]; then
    privileged+=(-A)
  fi
fi

dependencies=(tar)
if [[ -z "$archive" ]]; then
  dependencies+=(curl)
fi
for dependency in "${dependencies[@]}"; do
  if ! command -v "$dependency" >/dev/null 2>&1; then
    echo "error: ${dependency} not found." >&2
    exit 1
  fi
done

temp_dir="$(mktemp -d)"
cleanup() {
  rm -rf "$temp_dir"
}
trap cleanup EXIT

if [[ -z "$archive" ]]; then
  architecture="$(uname -m)"
  case "$architecture" in
    x86_64 | aarch64) ;;
    arm64) architecture="aarch64" ;;
    *)
      echo "error: unsupported architecture '${architecture}'." >&2
      exit 1
      ;;
  esac
  asset="zed-linux-${architecture}.tar.gz"
  if [[ -n "$tag" ]]; then
    url="https://github.com/${repository}/releases/download/${tag}/${asset}"
  else
    url="https://github.com/${repository}/releases/latest/download/${asset}"
  fi
  echo "==> Downloading ${url}"
  archive="${temp_dir}/${asset}"
  curl --fail --location --retry 3 --progress-bar --output "$archive" "$url"
fi

echo "==> Extracting ${archive}"
tar --no-same-owner -xzf "$archive" -C "$temp_dir"
bundle="${temp_dir}/zed.app"
for required in bin/zed libexec/zed-editor remote-server remote-server-version; do
  if [[ ! -e "${bundle}/${required}" ]]; then
    echo "error: ${archive} is not a fork release archive (missing zed.app/${required})." >&2
    exit 1
  fi
done

app_id="dev.zed.Zed"
desktop_source="${bundle}/share/applications/${app_id}.desktop"
icon_source="${bundle}/share/icons/hicolor/512x512/apps/zed.png"
icon_source_2x="${bundle}/share/icons/hicolor/1024x1024/apps/zed.png"
if [[ ! -f "$desktop_source" || ! -f "$icon_source" || ! -f "$icon_source_2x" ]]; then
  echo "error: ${archive} does not contain a stable channel desktop entry and icons." >&2
  exit 1
fi

# Must match AppVersion::load() in crates/release_channel, which the SSH client
# uses when looking for ~/.zed_server/zed-remote-server-*. The workflow records
# the label because it depends on the run number and commit of the build.
remote_version_label="$(tr -d '[:space:]' <"${bundle}/remote-server-version")"
server_dir="${HOME}/.zed_server"
server_binary_name="zed-remote-server-stable-${remote_version_label}"
server_dest="${server_dir}/${server_binary_name}"
data_home="${XDG_DATA_HOME:-${HOME}/.local/share}"
server_state_dir="${data_home}/zed/server_state"
server_logs_dir="${data_home}/zed/logs"

install_dir="${PREFIX}/lib/zed"
icon_dst_512="${PREFIX}/share/icons/hicolor/512x512/apps/zed.png"
icon_dst_1024="${PREFIX}/share/icons/hicolor/1024x1024/apps/zed.png"
# Also install under the app id name some launchers resolve more reliably.
icon_dst_512_app_id="${PREFIX}/share/icons/hicolor/512x512/apps/${app_id}.png"

collect_remote_server_pids() {
  local pid exe
  shopt -s nullglob
  for pid in /proc/[0-9]*; do
    pid="${pid#/proc/}"
    exe="$(readlink "/proc/${pid}/exe" 2>/dev/null || true)"
    if [[ "$exe" == *"/zed-remote-server-"* ]]; then
      printf '%s\n' "$pid"
    fi
  done
  shopt -u nullglob
}

collect_running_server_identifiers() {
  local pid_file identifier pid
  if [[ ! -d "$server_state_dir" ]]; then
    return 0
  fi
  shopt -s nullglob
  for pid_file in "$server_state_dir"/*/server.pid; do
    identifier="$(basename "$(dirname "$pid_file")")"
    pid="$(tr -d '[:space:]' <"$pid_file")"
    if [[ "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null; then
      printf '%s\n' "$identifier"
    fi
  done
  shopt -u nullglob
}

stop_remote_servers() {
  local pids=()
  local pid still=()
  while IFS= read -r pid; do
    if [[ -n "$pid" ]]; then
      pids+=("$pid")
    fi
  done < <(collect_remote_server_pids)
  if ((${#pids[@]} == 0)); then
    return 0
  fi

  echo "==> Stopping ${#pids[@]} running remote server process(es)"
  kill "${pids[@]}" 2>/dev/null || true

  for _ in {1..15}; do
    still=()
    for pid in "${pids[@]}"; do
      if kill -0 "$pid" 2>/dev/null; then
        still+=("$pid")
      fi
    done
    if ((${#still[@]} == 0)); then
      return 0
    fi
    pids=("${still[@]}")
    sleep 0.2
  done

  echo "==> Remote server did not exit, sending SIGKILL"
  kill -9 "${pids[@]}" 2>/dev/null || true
}

restart_remote_servers() {
  local identifier ident_dir log_file
  if ((${#restart_identifiers[@]} == 0)); then
    echo "==> Remote server was running; reconnect from the client to start the new binary"
    return 0
  fi

  echo "==> Restarting remote server for ${#restart_identifiers[@]} session(s)"
  mkdir -p "$server_logs_dir"
  for identifier in "${restart_identifiers[@]}"; do
    ident_dir="${server_state_dir}/${identifier}"
    mkdir -p "$ident_dir"
    log_file="${server_logs_dir}/server-${identifier}.log"
    rm -f \
      "${ident_dir}/stdin.sock" \
      "${ident_dir}/stdout.sock" \
      "${ident_dir}/stderr.sock" \
      "${ident_dir}/server.pid"
    nohup "$server_dest" run \
      --log-file "$log_file" \
      --pid-file "${ident_dir}/server.pid" \
      --stdin-socket "${ident_dir}/stdin.sock" \
      --stdout-socket "${ident_dir}/stdout.sock" \
      --stderr-socket "${ident_dir}/stderr.sock" \
      >/dev/null 2>&1 &
    disown || true
  done
}

system_library_path() {
  local soname="$1" abi
  case "$(uname -m)" in
    x86_64) abi="x86-64" ;;
    aarch64 | arm64) abi="AArch64" ;;
    *) return 1 ;;
  esac
  ldconfig -p 2>/dev/null |
    awk -v soname="$soname" -v abi="$abi" '$1 == soname && index($0, abi) { print $NF; exit }'
}

highest_glibcxx() {
  grep -aoE 'GLIBCXX_3\.4\.[0-9]+' "$1" | sort -uV | tail -n1
}

# The bundled libraries come from the older distribution the release is built
# on. Once loaded through the rpath they also satisfy the system graphics
# drivers the editor dlopens, so a bundled libstdc++ older than the system's
# makes Mesa's Vulkan driver fail to load ("No GPU adapters found"). Only keep
# the libraries this system lacks, or whose system libstdc++ is older.
prune_bundled_libraries() {
  local library soname system_library
  shopt -s nullglob
  for library in "${bundle}/lib"/*; do
    soname="$(basename "$library")"
    system_library="$(system_library_path "$soname" || true)"
    if [[ -z "$system_library" || ! -e "$system_library" ]]; then
      echo "==> Keeping bundled ${soname} (not found on this system)"
      continue
    fi
    if [[ "$soname" == libstdc++.so.* ]]; then
      local bundled_version system_version
      bundled_version="$(highest_glibcxx "$library")"
      system_version="$(highest_glibcxx "$system_library")"
      if [[ "$(printf '%s\n%s\n' "$bundled_version" "$system_version" | sort -V | tail -n1)" != "$system_version" ]]; then
        echo "==> Keeping bundled ${soname} (${bundled_version} is newer than the system's ${system_version})"
        continue
      fi
    fi
    rm -f "$library"
  done
  shopt -u nullglob
}

if [[ -d "${bundle}/lib" ]]; then
  prune_bundled_libraries
fi

desktop_file="${temp_dir}/${app_id}.desktop"
# Absolute path so the launcher shows the icon even before icon caches refresh.
sed "s|^Icon=.*|Icon=${icon_dst_512}|" "$desktop_source" >"$desktop_file"

restart_identifiers=()
while IFS= read -r identifier; do
  if [[ -n "$identifier" ]]; then
    restart_identifiers+=("$identifier")
  fi
done < <(collect_running_server_identifiers)
remote_server_was_running=false
if ((${#restart_identifiers[@]} > 0)) || [[ -n "$(collect_remote_server_pids)" ]]; then
  remote_server_was_running=true
  stop_remote_servers
fi

# All privileged steps run in one invocation, so the password is asked for
# only once, even by helpers that do not cache credentials.
system_install_script="${temp_dir}/install-system-files.sh"
cat >"$system_install_script" <<'SYSTEM_INSTALL'
set -euo pipefail
bundle="$1"
PREFIX="$2"
install_dir="$3"
desktop_file="$4"
app_id="$5"
icon_source="$6"
icon_source_2x="$7"
icon_dst_512="$8"
icon_dst_512_app_id="$9"
icon_dst_1024="${10}"

# The editor finds its bundled libraries through the $ORIGIN/../lib rpath, so
# the bundle layout is kept intact. Replacing the whole directory also removes
# the zed-editor left there by script/install-linux-system.
staged_dir="${install_dir}.new"
rm -rf "$staged_dir"
mkdir -p "$staged_dir"
cp -a --no-preserve=ownership "${bundle}/bin" "${bundle}/libexec" "$staged_dir/"
if [[ -d "${bundle}/lib" ]]; then
  cp -a --no-preserve=ownership "${bundle}/lib" "$staged_dir/"
fi
if [[ -f "${bundle}/licenses.md" ]]; then
  install -m644 "${bundle}/licenses.md" "$staged_dir/licenses.md"
fi
rm -rf "$install_dir"
mv "$staged_dir" "$install_dir"
# The CLI resolves its own symlink and looks for ../libexec/zed-editor.
mkdir -p "${PREFIX}/bin"
ln -sfn "${install_dir}/bin/zed" "${PREFIX}/bin/zed"
install -Dm755 "$desktop_file" "${PREFIX}/share/applications/${app_id}.desktop"
install -Dm644 "$icon_source" "$icon_dst_512"
install -Dm644 "$icon_source" "$icon_dst_512_app_id"
install -Dm644 "$icon_source_2x" "$icon_dst_1024"

# Remove desktop entries left over from other channels so only one shortcut remains.
for stale_id in dev.zed.Zed-Dev dev.zed.Zed-Preview dev.zed.Zed-Nightly; do
  rm -f "${PREFIX}/share/applications/${stale_id}.desktop"
done

if command -v gtk-update-icon-cache >/dev/null 2>&1; then
  gtk-update-icon-cache -f "${PREFIX}/share/icons/hicolor" >/dev/null 2>&1 || true
fi
if command -v update-desktop-database >/dev/null 2>&1; then
  update-desktop-database "${PREFIX}/share/applications" >/dev/null 2>&1 || true
fi
SYSTEM_INSTALL

echo "==> Installing into ${PREFIX} (requires privileges)"
${privileged[@]+"${privileged[@]}"} "$(command -v bash)" "$system_install_script" \
  "$bundle" "$PREFIX" "$install_dir" "$desktop_file" "$app_id" \
  "$icon_source" "$icon_source_2x" "$icon_dst_512" "$icon_dst_512_app_id" "$icon_dst_1024"

echo "==> Installing remote server to ${server_dest}"
install -Dm755 "${bundle}/remote-server" "$server_dest"
"$server_dest" version >/dev/null

if [[ "$remote_server_was_running" == true ]]; then
  restart_remote_servers
fi

echo
echo "Installed:"
echo "  ${PREFIX}/bin/zed -> ${install_dir}/bin/zed"
echo "  ${install_dir}/libexec/zed-editor"
echo "  ${server_dest}"
echo "  ${PREFIX}/share/applications/${app_id}.desktop"
echo "  ${icon_dst_512}"
echo
"${PREFIX}/bin/zed" --version
