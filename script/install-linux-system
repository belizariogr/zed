#!/usr/bin/env bash

set -euo pipefail

usage() {
  cat <<EOF
Usage: ${0##*/}

Builds Zed in release mode as the stable channel and installs it system-wide:

  \$PREFIX/bin/zed              CLI (default: /usr/bin/zed)
  \$PREFIX/lib/zed/zed-editor   Editor binary
  \$PREFIX/share/applications/  Desktop entry
  \$PREFIX/share/icons/         App icons
  ~/.zed_server/zed-remote-server-*
                               Remote development server (matches this build)

If a remote server daemon is already running, it is stopped before the new
binary is installed and started again afterward.

Environment:
  PREFIX               Install prefix (default: /usr)
  SUDO                 Privilege helper (default: sudo)
  ZED_RELEASE_CHANNEL  Channel baked into the binary (default: stable)

Before running this you should ensure you have all the build dependencies
installed with \`./script/linux\`.
EOF
}

if [[ $# -gt 0 ]]; then
  usage
  exit 1
fi

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root"

PREFIX="${PREFIX:-/usr}"
SUDO="${SUDO:-sudo}"
channel="${ZED_RELEASE_CHANNEL:-stable}"
export ZED_RELEASE_CHANNEL="$channel"

if ! command -v cargo >/dev/null 2>&1; then
  if [[ -f "${HOME}/.cargo/env" ]]; then
    # shellcheck source=/dev/null
    source "${HOME}/.cargo/env"
  fi
fi

if ! command -v cargo >/dev/null 2>&1; then
  echo "error: cargo not found. Install Rust with rustup, then retry." >&2
  exit 1
fi

if ! command -v "$SUDO" >/dev/null 2>&1; then
  echo "error: '${SUDO}' not found. Install as root or set SUDO=." >&2
  exit 1
fi

case "$channel" in
  stable | preview | nightly | dev) ;;
  *)
    echo "error: invalid ZED_RELEASE_CHANNEL '${channel}'" >&2
    echo "expected one of: stable, preview, nightly, dev" >&2
    exit 1
    ;;
esac

version="$(script/get-crate-version zed)"
export RELEASE_VERSION="${version}"
export ZED_UPDATE_EXPLANATION="Rebuild with ${root}/script/install-linux-system"

git_sha="$(git rev-parse HEAD 2>/dev/null || true)"
if [[ -n "$git_sha" ]]; then
  export ZED_COMMIT_SHA="$git_sha"
fi

# Filename must match AppVersion::load() in crates/release_channel, which the
# SSH client uses when looking for ~/.zed_server/zed-remote-server-*.
if [[ "$channel" == "dev" ]]; then
  remote_version_label="build"
else
  remote_build_metadata="$channel"
  if [[ -n "${GITHUB_RUN_NUMBER:-}" ]]; then
    remote_build_metadata="${remote_build_metadata}.${GITHUB_RUN_NUMBER}"
  fi
  if [[ -n "$git_sha" ]]; then
    remote_build_metadata="${remote_build_metadata}.${git_sha}"
  fi
  remote_version_label="${version}+${remote_build_metadata}"
fi

server_dir="${HOME}/.zed_server"
server_binary_name="zed-remote-server-${channel}-${remote_version_label}"
server_dest="${server_dir}/${server_binary_name}"
data_home="${XDG_DATA_HOME:-${HOME}/.local/share}"
server_state_dir="${data_home}/zed/server_state"
server_logs_dir="${data_home}/zed/logs"

strip_remote_server() {
  local src="$1"
  local dst="$2"
  if command -v llvm-objcopy >/dev/null 2>&1 && llvm-objcopy --strip-debug --discard-all "$src" "$dst"; then
    :
  elif command -v objcopy >/dev/null 2>&1 && objcopy --strip-debug --discard-all "$src" "$dst"; then
    :
  elif command -v strip >/dev/null 2>&1 && cp "$src" "$dst" && strip --strip-debug "$dst"; then
    :
  else
    cp "$src" "$dst"
  fi
  chmod 755 "$dst"
}

collect_remote_server_pids() {
  local pid exe
  shopt -s nullglob
  for pid in /proc/[0-9]*; do
    pid="${pid#/proc/}"
    exe="$(readlink "/proc/${pid}/exe" 2>/dev/null || true)"
    if [[ "$exe" == *"/zed-remote-server-"* ]]; then
      printf '%s\n' "$pid"
    fi
  done
  shopt -u nullglob
}

collect_running_server_identifiers() {
  local pid_file identifier pid
  if [[ ! -d "$server_state_dir" ]]; then
    return 0
  fi
  shopt -s nullglob
  for pid_file in "$server_state_dir"/*/server.pid; do
    identifier="$(basename "$(dirname "$pid_file")")"
    pid="$(tr -d '[:space:]' <"$pid_file")"
    if [[ "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null; then
      printf '%s\n' "$identifier"
    fi
  done
  shopt -u nullglob
}

stop_remote_servers() {
  local pids=()
  local pid still=()
  while IFS= read -r pid; do
    if [[ -n "$pid" ]]; then
      pids+=("$pid")
    fi
  done < <(collect_remote_server_pids)
  if ((${#pids[@]} == 0)); then
    return 0
  fi

  echo "==> Stopping ${#pids[@]} running remote server process(es)"
  kill "${pids[@]}" 2>/dev/null || true

  local attempt
  for attempt in {1..15}; do
    still=()
    for pid in "${pids[@]}"; do
      if kill -0 "$pid" 2>/dev/null; then
        still+=("$pid")
      fi
    done
    if ((${#still[@]} == 0)); then
      return 0
    fi
    pids=("${still[@]}")
    sleep 0.2
  done

  echo "==> Remote server did not exit, sending SIGKILL"
  kill -9 "${pids[@]}" 2>/dev/null || true
}

restart_remote_servers() {
  local identifier ident_dir log_file
  if ((${#restart_identifiers[@]} == 0)); then
    echo "==> Remote server was running; reconnect from the client to start the new binary"
    return 0
  fi

  echo "==> Restarting remote server for ${#restart_identifiers[@]} session(s)"
  mkdir -p "$server_logs_dir"
  for identifier in "${restart_identifiers[@]}"; do
    ident_dir="${server_state_dir}/${identifier}"
    mkdir -p "$ident_dir"
    log_file="${server_logs_dir}/server-${identifier}.log"
    rm -f \
      "${ident_dir}/stdin.sock" \
      "${ident_dir}/stdout.sock" \
      "${ident_dir}/stderr.sock" \
      "${ident_dir}/server.pid"
    nohup "$server_dest" run \
      --log-file "$log_file" \
      --pid-file "${ident_dir}/server.pid" \
      --stdin-socket "${ident_dir}/stdin.sock" \
      --stdout-socket "${ident_dir}/stdout.sock" \
      --stderr-socket "${ident_dir}/stderr.sock" \
      >/dev/null 2>&1 &
    disown || true
  done
}

echo "==> Building Zed ${version} (${channel}) in release mode"
cargo build --release --package zed --package cli
# Separate invocation avoids feature unification pulling extra dynamic libs
# into remote_server (same reason as script/bundle-linux).
echo "==> Building remote server in release mode"
cargo build --release --package remote_server

cli_bin="${CARGO_TARGET_DIR:-target}/release/cli"
editor_bin="${CARGO_TARGET_DIR:-target}/release/zed"
remote_server_bin="${CARGO_TARGET_DIR:-target}/release/remote_server"

if [[ ! -x "$cli_bin" || ! -x "$editor_bin" || ! -x "$remote_server_bin" ]]; then
  echo "error: expected release binaries were not produced:" >&2
  echo "  ${cli_bin}" >&2
  echo "  ${editor_bin}" >&2
  echo "  ${remote_server_bin}" >&2
  exit 1
fi

suffix=""
if [[ "$channel" != "stable" ]]; then
  suffix="-${channel}"
fi

case "$channel" in
  stable)
    app_id="dev.zed.Zed"
    app_name="Zed"
    ;;
  nightly)
    app_id="dev.zed.Zed-Nightly"
    app_name="Zed Nightly"
    ;;
  preview)
    app_id="dev.zed.Zed-Preview"
    app_name="Zed Preview"
    ;;
  dev)
    app_id="dev.zed.Zed-Dev"
    app_name="Zed Devel"
    ;;
esac

icon_src="crates/zed/resources/app-icon${suffix}.png"
icon_src_2x="crates/zed/resources/app-icon${suffix}@2x.png"
icon_dst_512="${PREFIX}/share/icons/hicolor/512x512/apps/zed.png"
icon_dst_1024="${PREFIX}/share/icons/hicolor/1024x1024/apps/zed.png"
# Also install under the app id name some launchers resolve more reliably.
icon_dst_512_app_id="${PREFIX}/share/icons/hicolor/512x512/apps/${app_id}.png"

if [[ ! -f "$icon_src" || ! -f "$icon_src_2x" ]]; then
  echo "error: missing icon assets for channel '${channel}':" >&2
  echo "  ${icon_src}" >&2
  echo "  ${icon_src_2x}" >&2
  exit 1
fi

temp_dir="$(mktemp -d)"
trap 'rm -rf "$temp_dir"' EXIT

stripped_remote_server="${temp_dir}/remote_server"
strip_remote_server "$remote_server_bin" "$stripped_remote_server"

desktop_file="${temp_dir}/${app_id}.desktop"
export DO_STARTUP_NOTIFY="true"
export APP_CLI="zed"
# Absolute path so the launcher shows the icon even before icon caches refresh.
export APP_ICON="$icon_dst_512"
export APP_ARGS="%U"
export APP_NAME="$app_name"
envsubst <"crates/zed/resources/zed.desktop.in" >"$desktop_file"
chmod 755 "$desktop_file"

restart_identifiers=()
while IFS= read -r identifier; do
  if [[ -n "$identifier" ]]; then
    restart_identifiers+=("$identifier")
  fi
done < <(collect_running_server_identifiers)
remote_server_was_running=false
if ((${#restart_identifiers[@]} > 0)) || [[ -n "$(collect_remote_server_pids)" ]]; then
  remote_server_was_running=true
  stop_remote_servers
fi

echo "==> Installing into ${PREFIX} (requires privileges)"
"$SUDO" install -Dm755 "$cli_bin" "${PREFIX}/bin/zed"
"$SUDO" install -Dm755 "$editor_bin" "${PREFIX}/lib/zed/zed-editor"
"$SUDO" install -Dm755 "$desktop_file" "${PREFIX}/share/applications/${app_id}.desktop"
"$SUDO" install -Dm644 "$icon_src" "$icon_dst_512"
"$SUDO" install -Dm644 "$icon_src" "$icon_dst_512_app_id"
"$SUDO" install -Dm644 "$icon_src_2x" "$icon_dst_1024"

echo "==> Installing remote server to ${server_dest}"
install -Dm755 "$stripped_remote_server" "$server_dest"
"$server_dest" version >/dev/null

# Remove desktop entries left over from other channels so only one shortcut remains.
for stale_id in dev.zed.Zed dev.zed.Zed-Dev dev.zed.Zed-Preview dev.zed.Zed-Nightly; do
  if [[ "$stale_id" != "$app_id" ]]; then
    "$SUDO" rm -f "${PREFIX}/share/applications/${stale_id}.desktop"
  fi
done

if command -v gtk-update-icon-cache >/dev/null 2>&1; then
  "$SUDO" gtk-update-icon-cache -f "${PREFIX}/share/icons/hicolor" >/dev/null 2>&1 || true
fi
if command -v update-desktop-database >/dev/null 2>&1; then
  "$SUDO" update-desktop-database "${PREFIX}/share/applications" >/dev/null 2>&1 || true
fi

if [[ "$remote_server_was_running" == true ]]; then
  restart_remote_servers
fi

echo
echo "Installed:"
echo "  ${PREFIX}/bin/zed"
echo "  ${PREFIX}/lib/zed/zed-editor"
echo "  ${server_dest}"
echo "  ${PREFIX}/share/applications/${app_id}.desktop"
echo "  ${icon_dst_512}"
echo
echo "Verify with: zed --version"
echo "Remote server: ${server_binary_name}"
echo "Run with: zed"
